# Server Port
PORT=3000

# MongoDB Connection String (replica set required for multi-document ACID transactions)
MONGO_URI=mongodb://localhost:27017/bank_ledger?replicaSet=rs0

# JWT Authentication Secret
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:3001

# Nodemailer / Gmail OAuth2 Credentials (Optional in dev; logs to console if not set)
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
